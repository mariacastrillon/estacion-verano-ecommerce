SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_tu_clave_secreta_solo_para_uso_local_admin
# Solo servidor del gestor local. URI directa/session pooler del MISMO proyecto.
# Necesaria para Eliminar; conservar privada y nunca usar prefijo VITE_.
# GESTOR_DATABASE_URL=postgresql://postgres:CLAVE@db.REFERENCIA.supabase.co:5432/postgres?sslmode=require
# Descargar del MISMO proyecto: Database Settings > SSL Configuration > Download Certificate.
# Guardar fuera del repositorio, public/ y src/. Ruta absoluta, sin prefijo VITE_.
# GESTOR_DATABASE_CA_PATH=C:\Users\TU_USUARIO\.supabase\certs\supabase-root.crt

# Compatibilidad opcional con proyectos que todavía usan la nomenclatura anterior:
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_solo_para_uso_local_admin
