# Copiar a .env.orders.local en la raiz. Usar proyecto de ensayo, no produccion.
ORDERS_API_ENABLED=false
ORDERS_EXPIRATION_ENABLED=false
# Solo Vite local: entero de 1 a 30. Ausente/invalido => 30; produccion => 30.
ORDERS_RESERVATION_TTL_MINUTES=2
# Conexion PostgreSQL privada del MISMO proyecto de ensayo (rol propietario).
# Necesaria solo para TTL corto; nunca usar prefijo VITE_.
ORDERS_DEV_DATABASE_URL=
ORDERS_ALLOWED_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=https://PROYECTO-DE-ENSAYO.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REEMPLAZAR
# Generar 32 bytes aleatorios (base64/hex). No rotar mientras haya intentos pendientes.
ORDERS_SESSION_SECRET=
